[
 {
  "function": "IN-TANK INVENTORY",
  "requires": "probe",
  "steps": [
   {
    "text": "VOLUME",
    "live": "volume"
   },
   {
    "text": "HEIGHT",
    "live": "height"
   },
   {
    "text": "WATER VOL",
    "live": "water_vol"
   },
   {
    "text": "WATER",
    "live": "water"
   },
   {
    "text": "TEMPERATURE",
    "live": "temperature"
   },
   {
    "text": "ULLAGE",
    "live": "ullage"
   },
   {
    "text": "TC VOLUME",
    "live": "tc_volume"
   },
   {
    "text": "DENSITY",
    "live": "density",
    "when": {
     "code": "S56000",
     "is": [
      "1"
     ]
    }
   },
   {
    "text": "MASS",
    "live": "mass",
    "when": {
     "code": "S56000",
     "is": [
      "1"
     ]
    }
   },
   {
    "text": "DELIVERY",
    "live": "delivery"
   },
   {
    "text": "NEXT DELIVER DENSITY",
    "live": "next_density",
    "when": {
     "code": "S56000",
     "is": [
      "1"
     ]
    }
   },
   {
    "text": "LAST DELIVERY DENSITY",
    "live": "last_density",
    "when": {
     "code": "S56000",
     "is": [
      "1"
     ]
    }
   }
  ],
  "print": "inventory"
 },
