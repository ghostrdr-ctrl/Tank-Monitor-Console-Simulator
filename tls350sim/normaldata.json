 {
  "function": "LAST-SHIFT INVENTORY",
  "requires": "probe",
  "steps": [
   {
    "text": "BEGINNING INVENTORY",
    "live": "shift_opening",
    "head": "shift",
    "print_scope": "device",
    "reading": "BEGIN INVENTORY: {}"
   },
   {
    "text": "ENDING INVENTORY",
    "live": "shift_physical",
    "head": "shift",
    "reading": "END INVENTORY: {}"
   },
   {
    "text": "DELIVERY ADJUSTMENT",
    "live": "shift_deliveries",
    "head": "shift",
    "shift_adjust": true,
    "reading": "DLVY ADJUSTMENT: {}",
    "when": {
     "code": "S51C00",
     "is": [
      "0",
      ""
     ]
    }
   },
   {
    "text": "GROSS CHANGE",
    "live": "shift_gross",
    "head": "shift",
    "reading": "GROSS CHANGE: {}"
   },
   {
    "text": "CLOSE CURRENT SHIFT",
    "live": null,
    "action": "close:shift",
    "head": "plain",
    "body": "CLOSE NOW: NO"
   }
  ],
  "when": {
   "shift_times": true
  },
  "print": "last_shift"
