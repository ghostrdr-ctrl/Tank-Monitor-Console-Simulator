[
 {
  "function": "IN-TANK INVENTORY",
  "requires": "probe",
  "steps": [
   {
    "text": "VOLUME",
    "live": "volume"
   },
   {
    "text": "HEIGHT",
    "live": "height"
   },
   {
    "text": "WATER VOL",
    "live": "water_vol"
   },
   {
    "text": "WATER",
    "live": "water"
   },
   {
    "text": "TEMP",
    "live": "temperature"
   },
   {
    "text": "ULLAGE",
    "live": "ullage"
   },
   {
    "text": "TC VOLUME",
    "live": "tc_volume"
   },
   {
    "text": "DELIVERY",
    "live": "delivery",
    "print_scope": "device",
    "print_kind": "increase"
   },
   {
    "text": "DENSITY",
    "live": "density",
    "when": {
     "code": "S56000",
     "is": [
      "1"
     ]
    }
   },
   {
    "text": "MASS",
    "live": "mass",
    "when": {
     "code": "S56000",
     "is": [
      "1"
     ]
    }
   },
   {
    "text": "NEXT DELIVER DENSITY",
    "live": "next_density",
    "head": "T %d: NEXT DELIVERY",
    "reading": "DENSITY = {}",
    "density": "0",
    "when": {
     "code": "S56000",
     "is": [
      "1"
     ]
    }
   },
   {
    "text": "LAST DELIVERY DENSITY",
    "live": "last_density",
    "head": "T %d: LAST DELIVERY",
    "reading": "DENSITY = {}",
    "density": "1",
    "when": {
     "code": "S56000",
     "is": [
      "1"
     ],
     "has_delivery": true
    }
   }
  ],
  "print": "inventory"
 },
 {
  "function": "DELIVERY MAINTENANCE",
  "requires": "probe",
  "steps": [
   {
    "text": "EDIT/VIEW OR INSERT",
    "live": null,
    "sel": "dlv_mode",
    "choices": [
     "EDIT/VIEW",
     "INSERT"
    ],
    "sel_label": "SELECT"
   },
   {
    "text": "SELECT",
    "live": null,
    "dlv": "tank",
    "print_scope": "device"
   },
   {
    "text": "TICKET VOLUME",
    "live": null,
    "dlv": "ticket",
    "print_scope": "device",
    "when": {
     "sel": "dlv_mode",
     "is": [
      "EDIT/VIEW"
     ]
    }
   },
   {
    "text": "BOL",
    "live": null,
    "dlv": "bol",
    "print_scope": "device",
    "when": {
     "sel": "dlv_mode",
     "is": [
      "EDIT/VIEW"
     ]
    }
   },
   {
    "text": "ENTER DELIVERY DATE",
    "live": null,
    "dlv": "date",
    "when": {
     "sel": "dlv_mode",
     "is": [
      "INSERT"
     ]
    }
   },
   {
    "text": "ENTER DELIVERY TIME",
    "live": null,
    "dlv": "time",
    "when": {
     "sel": "dlv_mode",
     "is": [
      "INSERT"
     ]
    }
   },
   {
    "text": "ENTER TICKET VOLUME",
    "live": null,
    "dlv": "insert",
    "when": {
     "sel": "dlv_mode",
     "is": [
      "INSERT"
     ]
    }
   },
   {
    "text": "BOL",
    "live": null,
    "dlv": "insertbol",
    "when": {
     "sel": "dlv_mode",
     "is": [
      "INSERT"
     ]
    }
   }
  ],
  "when": {
   "software": "bir",
   "code": "S51C00",
   "is": [
    "1"
   ]
  },
  "print": "deliveries"
 },
