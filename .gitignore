# what the console writes while it runs
console_state.json
*.vrset
launch_err.txt

# A real site's printout and the backup behind it. Same rule as
# tests/real_backups/: the data stays on the machine that has it and never
# goes into the repository, because it carries the site's address and its
# account number. tests/test_tape.py skips when it is not there.
tests/tape/

# python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/

# virtualenvs
.venv/
venv/
env/

# scratch state the tests and screenshots leave behind
tests/_*.json
*.log

# editors and operating systems
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# the manuals this was built from: large, and Veeder-Root's to distribute
reference/*.pdf
# and text pulled out of them: same documents, same reason
reference/*.txt

# photographs of real hardware: reference only, not ours to distribute
reference_console.png
reference_keypad.png

# generated by packaging/make_version_info.py from __version__
packaging/version_info.txt

# real console backups a developer drops in to replay; never committed
tests/real_backups/

# stray editor file
New Text Document*.txt
